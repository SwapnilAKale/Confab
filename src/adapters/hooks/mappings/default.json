{
  "about": "Conventions shared by most agent harnesses. A harness file overrides only the keys that differ; each key under events and fields is replaced as a whole.",
  "input": "stdin",
  "eventField": ["hook_event_name"],
  "events": {
    "turn": ["UserPromptSubmit", "BeforeAgent"],
    "reply": ["Stop", "AfterAgent"],
    "detach": ["SessionEnd"]
  },
  "fields": {
    "prompt": ["prompt"],
    "reply": ["last_assistant_message", "prompt_response"],
    "session": ["session_id", "conversation_id", "conversationId"],
    "turn": ["turn_id"],
    "transcript": []
  },
  "transcript": null,
  "ignore": [],
  "stdout": {}
}
